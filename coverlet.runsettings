<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings: hosting boilerplate and compiled Razor views are excluded, as they are covered by E2E tests rather than unit tests -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Exclude>[*]BPCalculator.Program,[*]BPCalculator.Startup,[*]BPCalculator.Pages.Pages_*,[*]AspNetCoreGeneratedDocument.*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
